<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Must match the identity SonicOrca.dll was compiled against -->
    <AssemblyName>Accord.Video.FFMPEG.x64</AssemblyName>
    <AssemblyVersion>3.7.0.0</AssemblyVersion>
    <FileVersion>3.7.0.0</FileVersion>
    <RootNamespace>Accord.Video.FFMPEG</RootNamespace>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FFMediaToolkit" Version="4.8.1" />
    <!-- Accord.Math.Rational (FrameRate) lives here; Accord.dll is pure IL and loads fine -->
    <Reference Include="Accord" HintPath="..\..\lib\Accord.dll" />
  </ItemGroup>

</Project>
