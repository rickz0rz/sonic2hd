<Project>
  <!-- Apple Silicon build; tools/macos/build-app.sh turns this folder into S2HD.app (run on a Mac) -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- Precompile to native code to cut JIT time at startup -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishDir>$(MSBuildProjectDirectory)\publish\S2HD-osx-arm64\</PublishDir>
    <DeleteExistingFiles>true</DeleteExistingFiles>
  </PropertyGroup>
</Project>
