<Project>
  <!-- Portable release folder: runs without the .NET runtime or the original game install -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- Precompile to native code to cut JIT time at startup -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishDir>$(MSBuildProjectDirectory)\publish\S2HD-win-x64\</PublishDir>
    <DeleteExistingFiles>true</DeleteExistingFiles>
  </PropertyGroup>
</Project>
