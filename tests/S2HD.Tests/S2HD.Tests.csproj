<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests for the resource file format, and a screenshot regression test that plays the attract demo -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../engine/SonicOrca.Resources/SonicOrca.Resources.csproj" />
    <!-- For the PNG reader used to compare screenshots -->
    <ProjectReference Include="../../engine/SonicOrca/SonicOrca.csproj" />
    <!-- For unit tests of the renderer logic that do not need a GPU -->
    <ProjectReference Include="../../engine/SonicOrca.Drawing/SonicOrca.Drawing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The settings class of the game, to test how it saves the settings without the game window -->
    <Compile Include="../../S2HD/S2HDSettings.cs" Link="Game/S2HDSettings.cs" />
    <!-- The slot machine logic of Casino Night Zone, which needs only the engine -->
    <Compile Include="../../SONICORCA/OBJECTS/CNZSLOTCAGE/CNZSlotMachine.cs" Link="Game/CNZSlotMachine.cs" />
    <!-- The list of the levels and the order of the story -->
    <Compile Include="../../SONICORCA/Core/Levels.cs" Link="Game/Levels.cs" />
    <Compile Include="../../SONICORCA/Core/LevelInfo.cs" Link="Game/LevelInfo.cs" />
    <Compile Include="../../SONICORCA/Core/NewLevel.cs" Link="Game/NewLevel.cs" />
    <!-- The palette fades of the original credits -->
    <Compile Include="../../S2HD/MegaDriveFade.cs" Link="Game/MegaDriveFade.cs" />
    <!-- The logic of the ending cutscene that does not draw -->
    <Compile Include="../../S2HD/Ending/EndingLogic.cs" Link="Game/EndingLogic.cs" />
  </ItemGroup>

</Project>
