<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!-- Browser build: the game and engine compiled to WebAssembly, rendering through WebGL2 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>S2HD.Web</AssemblyName>
    <RootNamespace>S2HD</RootNamespace>
    <!-- Same version as the desktop game (shown on the title screen) -->
    <Version>2.0.1012.10521</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Same warning suppressions as the desktop game and engine (decompiled code) -->
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414;CS0219;CS0168;CA1416</NoWarn>
    <!-- AOT requires trimming. The engine finds object types and resources by reflection, so only assemblies
         that opt in to trimming (the framework) are trimmed; the game and engine assemblies are kept whole -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <!-- Release publishes compile ahead of time; the interpreter is far too slow for the game.
         Requires the wasm-tools workload: dotnet workload install wasm-tools (from an administrator terminal) -->
    <RunAOTCompilation Condition=" '$(Configuration)' == 'Release' ">true</RunAOTCompilation>
    <RepoRoot>$(MSBuildThisFileDirectory)../../</RepoRoot>
  </PropertyGroup>

  <ItemGroup>
    <!-- Game code shared with the desktop build; web/Program.cs replaces the desktop entry point -->
    <Compile Include="$(RepoRoot)S2HD/**/*.cs" Exclude="$(RepoRoot)S2HD/Program.cs" Link="Game/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(RepoRoot)SONICORCA/**/*.cs" Link="Game/SONICORCA/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- GL backend shared with the desktop build, compiled against the WebGL implementation of GL in Platform/ -->
    <Compile Include="$(RepoRoot)engine/SonicOrca.SDL2/SonicOrca.SDL2/GL*.cs;$(RepoRoot)engine/SonicOrca.SDL2/SonicOrca.SDL2/IGLWindow.cs" Link="SharedGL/%(Filename)%(Extension)" />
    <!-- Shaders are written to the in-memory file system at startup -->
    <EmbeddedResource Include="$(RepoRoot)assets/shaders/**/*" LogicalName="shaders/%(RecursiveDir)%(Filename)%(Extension)" />
    <TrimmerRootAssembly Include="S2HD.Web;SonicOrca;SonicOrca.Common;SonicOrca.Resources;SonicOrca.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)engine/SonicOrca.Common/SonicOrca.Common.csproj" />
    <ProjectReference Include="$(RepoRoot)engine/SonicOrca.Resources/SonicOrca.Resources.csproj" />
    <ProjectReference Include="$(RepoRoot)engine/SonicOrca/SonicOrca.csproj" />
    <ProjectReference Include="$(RepoRoot)engine/SonicOrca.Drawing/SonicOrca.Drawing.csproj" />
    <!-- Enum and type definitions for the shared GL backend; GL calls themselves go to WebGL -->
    <PackageReference Include="OpenTK.Graphics" Version="4.9.4" />
  </ItemGroup>

  <!-- Builds also produce a servable folder (the SDK otherwise only copies wwwroot on publish) -->
  <Target Name="CopyStaticFilesOnBuild" AfterTargets="Build">
    <ItemGroup>
      <S2HDStaticFile Include="wwwroot/**" />
    </ItemGroup>
    <Copy SourceFiles="@(S2HDStaticFile)" DestinationFiles="@(S2HDStaticFile->'$(OutDir)wwwroot/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <!-- Optional: -p:BundleGameData=true puts the game data into the site as game.zip, and the page starts without
       asking for files. GameDir has the same default as the desktop build. The credits film is left out because the
       web build does not play video. Without the property, a game.zip from an earlier publish is removed -->
  <PropertyGroup>
    <GameDir Condition=" '$(GameDir)' == '' ">$([System.Environment]::GetFolderPath(SpecialFolder.UserProfile))/Downloads/S2HD_2.0.1012-rc2/S2HD_2.0.1012-rc2/</GameDir>
  </PropertyGroup>

  <Target Name="BundleGameData" AfterTargets="Publish">
    <PropertyGroup>
      <GameDataZip>$([MSBuild]::EnsureTrailingSlash('$(PublishDir)'))wwwroot/game.zip</GameDataZip>
      <GameDataStaging>$(IntermediateOutputPath)gamedata/</GameDataStaging>
    </PropertyGroup>
    <Delete Files="$(GameDataZip)" Condition=" '$(BundleGameData)' != 'true' " />
    <ItemGroup Condition=" '$(BundleGameData)' == 'true' ">
      <GameDataFile Include="$(GameDir)data/*.dat" />
    </ItemGroup>
    <Error Condition=" '$(BundleGameData)' == 'true' And '@(GameDataFile)' == '' " Text="No game data in $(GameDir)data/. Set -p:GameDir=/path/to/S2HD_2.0.1012-rc2/ (keep the trailing slash)." />
    <RemoveDir Directories="$(GameDataStaging)" Condition=" '$(BundleGameData)' == 'true' " />
    <Copy SourceFiles="@(GameDataFile)" DestinationFolder="$(GameDataStaging)data" Condition=" '$(BundleGameData)' == 'true' " />
    <ZipDirectory SourceDirectory="$(GameDataStaging)" DestinationFile="$(GameDataZip)" Overwrite="true" Condition=" '$(BundleGameData)' == 'true' " />
  </Target>

</Project>
