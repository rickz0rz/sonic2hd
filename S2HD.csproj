<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>S2HD</AssemblyName>
    <RootNamespace>S2HD</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Assembly attributes are kept in AssemblyInfo.cs;
         only let the SDK generate the TargetFramework attribute -->
    <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
    <GenerateAssemblyDescriptionAttribute>false</GenerateAssemblyDescriptionAttribute>
    <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
    <GenerateAssemblyCopyrightAttribute>false</GenerateAssemblyCopyrightAttribute>
    <GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
    <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
    <GenerateAssemblyTrademarkAttribute>false</GenerateAssemblyTrademarkAttribute>
    <!-- Default to the Windows build for local development; publish profiles select other platforms -->
    <RuntimeIdentifier Condition=" '$(RuntimeIdentifier)' == '' ">win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationVersion>2.0.1012.10521</ApplicationVersion>
    <!-- Original S2HD icon, extracted from the 2.0.1012-rc2 executable -->
    <ApplicationIcon>assets/S2HD.ico</ApplicationIcon>
    <!-- CS0649: [ResourcePath] fields are populated by the engine via reflection -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
    <!-- Original game install providing native binaries and assets (override with -p:GameDir=...) -->
    <GameDir Condition=" '$(GameDir)' == '' ">$([System.Environment]::GetFolderPath(SpecialFolder.UserProfile))/Downloads/S2HD_2.0.1012-rc2/S2HD_2.0.1012-rc2/</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Engine, tool, test and web projects build separately; publish\ holds release output -->
    <Compile Remove="engine\**;publish\**;tests\**;tools\**;web\**" />
    <None Remove="engine\**;publish\**;tests\**;tools\**;web\**" />
  </ItemGroup>

  <!-- Game assets from the original install -->
  <ItemGroup Condition=" Exists('$(GameDir)') ">
    <None Include="$(GameDir)credits.film" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(GameDir)data/**/*" Link="data/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shaders are kept in the repo (patched for core-profile OpenGL); the engine loads them from shaders/ -->
    <None Include="assets/shaders/**/*" Link="shaders/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Windows native libraries: SDL2 from the original install, FFmpeg 7.1 from tools\get-ffmpeg.ps1.
       macOS builds get theirs from tools/macos/build-app.sh instead.
       (Checked here rather than in a property: items are evaluated after publish profiles set the RID.) -->
  <ItemGroup Condition=" $(RuntimeIdentifier.StartsWith('win')) ">
    <None Include="$(GameDir)SDL2.dll" Link="SDL2.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" Condition=" Exists('$(GameDir)SDL2.dll') " />
    <None Include="lib/ffmpeg/*" Link="ffmpeg/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <Target Name="WarnMissingFFmpeg" BeforeTargets="Build" Condition=" $(RuntimeIdentifier.StartsWith('win')) And !Exists('lib/ffmpeg/avcodec-61.dll') ">
    <Warning Text="FFmpeg 7.1 libraries not found in lib\ffmpeg; video playback will fail. Run tools\get-ffmpeg.ps1." />
  </Target>

  <ItemGroup>
    <!-- Decompiled SonicOrca engine -->
    <ProjectReference Include="engine/SonicOrca.Common/SonicOrca.Common.csproj" />
    <ProjectReference Include="engine/SonicOrca.Resources/SonicOrca.Resources.csproj" />
    <ProjectReference Include="engine/SonicOrca/SonicOrca.csproj" />
    <ProjectReference Include="engine/SonicOrca.Drawing/SonicOrca.Drawing.csproj" />
    <ProjectReference Include="engine/SonicOrca.SDL2/SonicOrca.SDL2.csproj" />
    <!-- Program uses SDL directly for the error message box -->
    <Reference Include="SDL2-CS" HintPath="lib/SDL2-CS.dll" />
  </ItemGroup>

  <Import Project="CommitSha.targets" />

</Project>
