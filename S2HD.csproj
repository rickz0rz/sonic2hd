<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- SonicOrca.Drawing depends on System.Drawing and System.Windows.Forms -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>S2HD</AssemblyName>
    <RootNamespace>S2HD</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Assembly attributes are kept in AssemblyInfo.cs -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Accord.Video.FFMPEG and the native SDL2/ffmpeg binaries are x64-only -->
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationVersion>2.0.1012.10521</ApplicationVersion>
    <!-- CS0649: [ResourcePath] fields are populated by the engine via reflection -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
    <!-- Original game install providing native binaries and assets (override with -p:GameDir=...) -->
    <GameDir Condition=" '$(GameDir)' == '' ">$(USERPROFILE)\Downloads\S2HD_2.0.1012-rc2\S2HD_2.0.1012-rc2\</GameDir>
  </PropertyGroup>

  <ItemGroup Condition=" Exists('$(GameDir)') ">
    <None Include="$(GameDir)SDL2.dll;$(GameDir)av*.dll;$(GameDir)postproc-*.dll;$(GameDir)sw*.dll;$(GameDir)credits.film" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(GameDir)data\**\*" Link="data\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(GameDir)Shaders\**\*" Link="Shaders\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="SonicOrca" HintPath="lib\SonicOrca.dll" />
    <Reference Include="SonicOrca.Common" HintPath="lib\SonicOrca.Common.dll" />
    <Reference Include="SonicOrca.Drawing" HintPath="lib\SonicOrca.Drawing.dll" />
    <Reference Include="SonicOrca.Resources" HintPath="lib\SonicOrca.Resources.dll" />
    <Reference Include="SonicOrca.SDL2" HintPath="lib\SonicOrca.SDL2.dll" />
    <!-- Transitive dependencies of the SonicOrca engine assemblies -->
    <Reference Include="Accord" HintPath="lib\Accord.dll" />
    <Reference Include="Accord.Video" HintPath="lib\Accord.Video.dll" />
    <Reference Include="Accord.Video.FFMPEG.x64" HintPath="lib\Accord.Video.FFMPEG.x64.dll" />
    <Reference Include="OpenTK" HintPath="lib\OpenTK.dll" />
    <Reference Include="SDL2-CS" HintPath="lib\SDL2-CS.dll" />
  </ItemGroup>

</Project>
