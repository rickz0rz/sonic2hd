root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets,xml,json}]
indent_style = space
indent_size = 2

[*.{js,html,css}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
indent_style = tab
indent_size = 4
tab_width = 4

# Namespaces and using directives
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# No "this." qualification
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning

# Language keywords for built-in types (int, not Int32)
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning

# Braces and new lines (Allman, as the engine code already uses)
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

# Diagnostics that dotnet format fixes
dotnet_diagnostic.IDE0003.severity = warning # Remove "this." qualification
dotnet_diagnostic.IDE0004.severity = warning # Remove unnecessary cast
dotnet_diagnostic.IDE0005.severity = warning # Remove unnecessary using directive
dotnet_diagnostic.IDE0049.severity = warning # Use language keywords for types
dotnet_diagnostic.IDE0161.severity = warning # Use file-scoped namespace

# Third-party libraries that are bundled with the engine. They are not decompiled game code, so they keep their style.
[engine/SonicOrca/{csogg,csvorbis,Hjg.Pngcs,Hjg.Pngcs.Chunks,Hjg.Pngcs.Zlib}/**.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
